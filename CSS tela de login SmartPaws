@import url('https://fonts.googleapis.com/css2?family=Luckiest+Guy&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap');

*{
    margin: 0;
    padding: 0;

}

body{
    background-image: url(../img/patinhasSP.png.png);
    background-size: cover;
    background-position: center 40%;
    background-repeat: no-repeat;
}

a{
    color: #ab8262;
}

.topo{
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #ab8262;
  height: 60%;
  width: 100%;
  color: white;
  font-size: 60%;
  font-family: 'montserrat';
}

.seguranca{
    display: flex;
    align-items: center;
    justify-content: right;
    margin-right: 10px;
    gap: 5px;
}

.cadeado{
    width: 3%;
}

.logo{
    width: 20%;
}

.mensagem{
    text-align: center;
    color: #ab8262;
    font-size: 160%;
    font-family: 'montserrat';
    font-weight: bold;
}

.email{
    display: flex;
    justify-content: center;
}

.email input{
    border-color: #ab8262;
    text-align: center;
    height: 30px;
    width: 30%;
    border-radius: 5px;
    font-family: 'luckiest guy';
}

.senha{
    display: flex;
    justify-content: center;
}

.senha input{
    border-color: #ab8262;
    text-align: center;
    height: 30px;
    width: 30%;
    border-radius: 5px;
    font-family: 'Luckiest Guy';
}

.esqueci{
    position: absolute;
    right: 35%;
    color: #ab8262;
    font-family: 'montserrat';
    font-weight: bold;
    font-size: 8px;
    text-decoration: underline;
    padding: 5px;
}

.entrar{
    display: flex;
    justify-content: center;
}

.entrar button{
  display: inline-block;
  text-align: center;
  font-size: 20px;
  text-decoration: none;
  border: none;
  background-color: #ab8262;
  color: white;
  border-radius: 25px;
  height: 40px;
  width: 12%;
  line-height: 40px;
  font-family: 'montserrat';
  font-weight: bold;
  transition: 0.5s; 
  
}

.entrar button:hover {
  background-color: white;
  color: #ab8262;
  border: 2px solid #ab8262;
}


.conta{
    text-align: center;
    color: #ab8262;
    font-size: 15px;
    font-family: 'montserrat';
    font-weight: bold;
}

.usuario{
    display: flex;
    justify-content: center;
}

.usuario a{
    display: inline-block;
    text-align: center;
    font-size: 8px;
    text-decoration: none;
    background-color: #ab8262;
    color: white;
    border-radius: 25px;
    height: 30px;
    width: 7%;
    line-height: 30px;
    font-family: 'montserrat';
    font-weight: bold;
    transition: 0.5s;
    
}

.usuario a:hover {
  background-color: white;
  color: #ab8262;
  border: 2px solid #ab8262;
}

.ou{
    text-align: center;
    color: #ab8262;
    font-size: 10px;
    font-family: 'montserrat';
    font-weight: bold;
    padding: 10px;
}

.loja{
    display: flex;
    justify-content: center;
}

.loja a{
    display: inline-block;
    text-align: center;
    font-size: 8px;
    text-decoration: none;
    background-color: #ab8262;
    color: white;
    border-radius: 25px;
    height: 30px;
    width: 7%;
    line-height: 30px;
    font-family: 'montserrat';
    font-weight: bold;
    transition: 0.5s;
   
}

.loja a:hover {
  background-color: white;
  color: #ab8262;
  border: 2px solid #ab8262;
}
