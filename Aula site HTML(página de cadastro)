<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NextGen.com</title>
</head>
<body>
    <h1>Faça o seu cadastro</h1>


<form action="" method="post">
<fieldset>
    
    <label for="usuario">Usuario:</label>
    <br>
    <input type="text" id="usuario" placeholder="Digite o seu usuario" required>
    <br>
    <label for="email">E-mail:</label>
    <br>
    <input type="email" id="email" name="email" placeholder="Digite o seu e-mail" required>
    <br>
    <label for="Senha">Senha:</label>
    <br>
    <input type="password" id="Senha" name="senha" placeholder="Digite a sua senha" required>
    <br>
    <label for="Senha">Confirme a senha:</label>
    <br>
    <input type="password" id="Senha" name="senha" placeholder="Confirme a sua senha" required>
    <br><br>
    <label>Sexo:</label>
    <br>
    <input type="radio" name="sexo" id="masc" value="M">
    <label for="masc">Masculino</label>
    <br>
    <input type="radio" name="sexo" id="fem" value="F">
    <label for="fem">Feminino</label>
    <br>
    <input type="radio" name="sexo" id="ind" value="I">
    <label for="ind">Prefiro não dizer</label>
    <br>
    <h2>Selecione os serviços a serem contratados: </h2>
    
    <input type="checkbox" name="Aeróbicos">Aeróbicos
    <br>
    <input type="checkbox" name="Danças">Danças
    <br>
    <input type="checkbox" name="Lutas">Lutas
    <br>
    <input type="checkbox" name="Musculação">Musculação
    <br><br>
    <button><a href="cadastroconcluido.html">Enviar</a> </button>
    <button type="reset">Apagar formulário</button>
    
   
   </fieldset>
    </form>
    </body>
    </html>
